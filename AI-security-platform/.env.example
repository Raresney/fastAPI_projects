# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/security_platform
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/security_platform

# Auth
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_URL=redis://redis:6379/0

# OpenAI (optional — fallback report generator works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# App
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
